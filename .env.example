# ==========================================
# TRADING LAB - ENVIRONMENT CONFIGURATION
# ==========================================

# --- SYSTEM & ENVIRONMENT ---
# Allowed safety values: BACKTEST, PAPER, LIVE_DISABLED
# (LIVE is explicitly blocked by the Phase 11 Readiness Gate until passed)
TRADING_LAB_ENV=PAPER

# --- PHASE 9: DATABASE (VPS) ---
# For local testing, you can leave this blank to default to local SQLite.
# For VPS deployment, provide your PostgreSQL connection string.
# Format: postgres://user:password@host:port/dbname
DATABASE_URL=

# --- PHASE 10: BROKER API (ANGEL ONE SMARTAPI) ---
# Your Angel One credentials for live market data and execution integration.
ANGEL_ONE_CLIENT_ID=
ANGEL_ONE_PASSWORD=
ANGEL_ONE_API_KEY=
ANGEL_ONE_TOTP_SECRET=

# --- PHASE 6: AI RESEARCH LOOP ---
# Provide the API key for the LLM that will drive the strategy generation.
# Example Providers: openai, anthropic, gemini
AI_PROVIDER=openai
AI_API_KEY=

# --- PHASE 8: DAILY REPORTING (EMAIL) ---
# SMTP credentials to send the end-of-day reports and DEATH alerts.
# If using Gmail, you will need an "App Password" for SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REPORT_FROM_EMAIL=
REPORT_TO_EMAIL=

# --- PHASE 4: HISTORICAL DATA (Optional) ---
# Depending on whether you use Angel One or a 3rd party (like Upstox/Kite) for historical backfill.
MARKET_DATA_API_KEY=
